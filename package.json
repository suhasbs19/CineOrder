{
  "name": "cineorder",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "audit:metadata": "npx tsx scripts/auditMetadata.ts",
    "release:gate": "npx tsx scripts/releaseGate.ts",
    "validate:recommendations": "npx tsx scripts/validateRecommendations.ts",
    "validate": "npm run validate:recommendations",
    "monitor:once": "npx tsx scripts/monitorDaemon.ts --once",
    "monitor:daemon": "npx tsx scripts/monitorDaemon.ts --daemon",
    "monitor": "npm run monitor:once"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.0",
    "framer-motion": "^11.18.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-helmet-async": "^2.0.5",
    "react-is": "^19.0.0",
    "react-router-dom": "^7.1.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "playwright": "^1.62.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.0",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.0"
  },
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom"
  }
}
